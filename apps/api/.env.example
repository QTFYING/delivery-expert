DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shou_db?schema=public
JWT_SECRET=replace-with-local-secret
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5001,http://localhost:5002,http://localhost:5003

PORT=3000

NODE_ENV=development

TZ=UTC

AUTH_COOKIE_SECURE=false

# 导入Worker
IMPORT_JOB_WORKER_ENABLED=false  # 是否启用导入 Worker 轮询；API 进程填 false，独立 Worker 进程填 true。
IMPORT_ACTIVE_JOB_TENANT_TTL_SECONDS=900  # 租户级活动正式导入任务占位 TTL，单位秒；默认 900 秒（15 分钟）。
IMPORT_ACTIVE_JOB_TENANT_RENEW_INTERVAL_SECONDS=60  # 租户级活动正式导入任务续期间隔，单位秒；必须小于占位 TTL，默认 60 秒。

# 短信开关
SMS_SEND_ENABLED=false
SMS_DEBUG_CODE_VISIBLE=true

# 阿里云 AccessKey
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 对象存储
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_PUBLIC_BASE_URL=
OSS_POLICY_EXPIRES_SECONDS=600
OSS_AVATAR_MAX_SIZE_BYTES=81920

# 阿里大于短信验证码配置
ALIYUN_SMS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_SIGN_NAME=速通互联验证码
ALIYUN_SMS_LOGIN_TEMPLATE_CODE=100001
ALIYUN_SMS_PASSWORD_RESET_TEMPLATE_CODE=100001

# 阿里云验证码 2.0 （滑块校验）可选配置
ALIYUN_CAPTCHA_ENDPOINT=captcha.cn-shanghai.aliyuncs.com
ALIYUN_CAPTCHA_SCENE_ID=

# 拉卡拉聚合收银台配置
LAKALA_BASE_URL=https://api.lakala.com
LAKALA_APP_ID=你的拉卡拉应用ID
LAKALA_SERIAL_NO=你的证书序列号
LAKALA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n请将你的私钥内容粘贴在这里\n注意保持格式正确\n-----END RSA PRIVATE KEY-----"
LAKALA_PLATFORM_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n请将拉卡拉的平台公钥内容粘贴在这里\n注意保持格式正确\n-----END PUBLIC KEY-----"
LAKALA_NOTIFY_URL=https://api.dev.shoudanba.cn/api/payment/webhook/lakala
